{
  "name": "tiltaksarrangor-flate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode dev",
    "build:demo": "NODE_ENV=development vite build --mode demo",
    "build:pull-request": "vite build --mode pull-request",
    "type-check": "tsc --noEmit && tsc --noEmit --project tsconfig.node.json",
    "test": "vitest",
    "test:no-watch": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "playwright": "playwright test",
    "playwright:debug": "playwright test --debug",
    "playwright:open": "playwright test --ui",
    "playwright:codegen": "playwright codegen playwright.dev"
  },
  "dependencies": {
    "@grafana/faro-react": "catalog:",
    "@grafana/faro-web-sdk": "catalog:",
    "@navikt/aksel-icons": "catalog:",
