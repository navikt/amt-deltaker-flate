    "@navikt/ds-react": "catalog:",
    "@navikt/nav-dekoratoren-moduler": "catalog:",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "dayjs": "catalog:",
    "deltaker-flate-common": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amt-deltaker-flate/playwright-config": "workspace:*",
    "@faker-js/faker": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "msw": "catalog:",
    "sass": "^1.105.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
