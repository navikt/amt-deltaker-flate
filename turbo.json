{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "shared-config/eslint-config/**",
    "shared-config/typescript-config/**"
  ],
  "tasks": {
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["^build", "type-check"],
      "outputs": ["build/**"]
    },
    "build:dev": {
      "dependsOn": ["^build", "type-check"],
      "outputs": ["build/**"]
    },
    "build:pull-request": {
      "dependsOn": ["^build", "type-check"],
      "outputs": ["build/**"]
    },
    "build:demo": {
      "dependsOn": ["^build", "type-check"],
      "outputs": ["build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:no-watch": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {},
    "lint:fix": {},
    "start": {
      "cache": false,
      "persistent": true
    },
    "playwright": {
      "env": ["PLAYWRIGHT_BROWSERS_PATH"],
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
